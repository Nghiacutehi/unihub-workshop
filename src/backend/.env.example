# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=unihub
DB_PASSWORD=unihub_secret
DB_NAME=unihub_workshop
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT
AUTH_SECRET=your-super-secret-key-change-in-production

# Payment Gateway (simulated)
PAYMENT_GATEWAY_URL=http://localhost:8080/mock/payment
PAYMENT_WEBHOOK_SECRET=webhook-secret-key

# AI Service
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=your-openai-api-key

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@unihub.edu.vn

# Server
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Batch Import
CSV_IMPORT_DIR=./data/imports
CSV_ARCHIVE_DIR=./data/archive

# Rate Limiting
RATE_LIMIT_CAPACITY=50
RATE_LIMIT_REFILL_RATE=5
RATE_LIMIT_TTL=300
